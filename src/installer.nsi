; NSIS Installer Script
; Generated by ExeForge HTML to Windows EXE Builder

!define PRODUCT_NAME "CP2077 TEXTURE ATLAS"
!define PRODUCT_VERSION "0.9.1"
!define PRODUCT_PUBLISHER "Big2What-mods"
!define PRODUCT_DIR_REGKEY "Software\Microsoft\Windows\CurrentVersion\App Paths\CP2077 TEXTURE ATLAS.exe"
!define PRODUCT_UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\CP2077 TEXTURE ATLAS"

SetCompressor lzma

!include "MUI2.nsh"

Name "CP2077 TEXTURE ATLAS ${PRODUCT_VERSION}"
OutFile "dist\CP2077 TEXTURE ATLAS-Setup-${PRODUCT_VERSION}.exe"
InstallDir "$PROGRAMFILES\CP2077 TEXTURE ATLAS"
InstallDirRegKey HKLM "${PRODUCT_DIR_REGKEY}" ""
ShowInstDetails show
ShowUnInstDetails show

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

Section "MainSection" SEC01
  SetOutPath "$INSTDIR"
  SetOverwrite ifnewer
  File /r "dist\win-unpacked\*"
  CreateDirectory "$SMPROGRAMS\CP2077 TEXTURE ATLAS"
  CreateShortCut "$SMPROGRAMS\CP2077 TEXTURE ATLAS\CP2077 TEXTURE ATLAS.lnk" "$INSTDIR\CP2077 TEXTURE ATLAS.exe"
  CreateShortCut "$DESKTOP\CP2077 TEXTURE ATLAS.lnk" "$INSTDIR\CP2077 TEXTURE ATLAS.exe"
SectionEnd

Section -Post
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  WriteRegStr HKLM "${PRODUCT_DIR_REGKEY}" "" "$INSTDIR\CP2077 TEXTURE ATLAS.exe"
  WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "DisplayName" "CP2077 TEXTURE ATLAS"
  WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "UninstallString" "$INSTDIR\Uninstall.exe"
  WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "DisplayVersion" "${PRODUCT_VERSION}"
  WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "Publisher" "Big2What-mods"
SectionEnd

Section Uninstall
  RMDir /r "$INSTDIR"
  Delete "$SMPROGRAMS\CP2077 TEXTURE ATLAS\CP2077 TEXTURE ATLAS.lnk"
  RMDir "$SMPROGRAMS\CP2077 TEXTURE ATLAS"
  Delete "$DESKTOP\CP2077 TEXTURE ATLAS.lnk"
  DeleteRegKey HKLM "${PRODUCT_UNINST_KEY}"
  DeleteRegKey HKLM "${PRODUCT_DIR_REGKEY}"
SectionEnd
